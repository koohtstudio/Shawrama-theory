# Copy to .env.local and fill in by hand. Names only: never commit real values.

# ── App ──────────────────────────────────────────────
NEXT_PUBLIC_APP_MODE=mock                 # mock | live
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase ─────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=                 # local: http://127.0.0.1:54321 (from `supabase status`)
NEXT_PUBLIC_SUPABASE_ANON_KEY=            # anon / publishable key
SUPABASE_SERVICE_ROLE_KEY=                # SECRET. Server only. Never expose to the browser.

# ── Security ─────────────────────────────────────────
ORDER_TOKEN_SECRET=                       # SECRET. 32+ random chars: `openssl rand -hex 32`

# ── Mock mode only ───────────────────────────────────
DEMO_STAFF_EMAIL=demo@shawarmatheory.test
DEMO_STAFF_PASSWORD=shawarma-demo-1       # matches supabase/seed.sql. Leave unset in live.
DEMO_ADMIN_CODE=                          # SECRET. Set on any internet-facing mock demo: visitors must type it to use Demo login.

# ── Live mode: required ──────────────────────────────
STRIPE_SECRET_KEY=                        # SECRET. sk_test_… first, then sk_live_…
STRIPE_WEBHOOK_SECRET=                    # SECRET. whsec_… from the Stripe webhook endpoint
RESEND_API_KEY=                           # SECRET
EMAIL_FROM=                               # e.g. "Shawarma Theory <orders@yourdomain.ca>" (verified in Resend)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=           # Cloudflare Turnstile site key (public)
TURNSTILE_SECRET_KEY=                     # SECRET

# ── Optional: text messages (Twilio) ─────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=                              # your Twilio number, e.g. +1705…
